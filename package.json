{
  "name": "@mailpace/mailpace.js",
  "version": "0.2.0",
  "description": "The official Node.js library for the MailPace transactional email API",
  "main": "build/main/index.js",
  "types": "build/main/index.d.ts",
  "typings": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "exports": {
    ".": {
      "types": "./build/main/index.d.ts",
      "default": "./build/main/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailpace/mailpace.js.git"
  },
  "homepage": "https://github.com/mailpace/mailpace.js#readme",
  "bugs": {
    "url": "https://github.com/mailpace/mailpace.js/issues"
  },
  "license": "MIT",
  "author": "MailPace",
  "keywords": [
    "mailpace",
    "email",
    "transactional-email",
    "smtp",
    "api"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "clean": "rimraf build coverage",
    "build": "npm run clean && npm run build:main && npm run build:module",
    "build:main": "tsc -p tsconfig.main.json",
    "build:module": "tsc -p tsconfig.module.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier \"src/**/*.ts\" --write",
    "format:check": "prettier \"src/**/*.ts\" --check",
    "spell": "cspell \"{README.md,CHANGELOG.md,.github/*.md,src/**/*.ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run spell && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "axios-mock-adapter": "^2.1.0",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "singleQuote": true
  }
}
